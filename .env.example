# Скопируйте в .env и раскомментируйте при необходимости

DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@127.0.0.1:5432/docdb
TEMPLATES_DIR=./templates
UPLOADS_DIR=./uploads
EXPORTS_DIR=./exports

# --- Подписи (сверка R008/R009 и подстановка при экспорте) ---
# EXPECTED_DIRECTOR=Утверждаю директор института … ФИО
# EXPECTED_DISCIPLINE_HEAD=Руководитель образовательной программы … ФИО

# --- Экспорт после сверки (/validation → Скачать DOCX) ---
# EXPORT_REQUIRE_VALIDATION=true
# EXPORT_REQUIRE_REAPPROVAL=false
# EXPORT_FILL_SIGNATURES=true
# EXPORT_FILL_REAPPROVAL=true
# EXPORT_USE_ORIGINAL=false
# DEFAULT_RPD_TEMPLATE_ID=
# DEFAULT_FOS_TEMPLATE_ID=
# DEFAULT_RPD_TEMPLATE_NAME=РПД FGOS 3 (макет)
# DEFAULT_FOS_TEMPLATE_NAME=ФОС FGOS 3 (макет)
# DEFAULT_RPP_TEMPLATE_NAME=РПп FGOS 3 (макет)
# DEFAULT_FOSP_TEMPLATE_NAME=ФОС практика FGOS 3 (макет)
# DEFAULT_GIA_TEMPLATE_NAME=ГИА B3_01 (макет)
# DEFAULT_FOS_GIA_TEMPLATE_NAME=ФОС ГИА B3_01 (макет)
# LAYOUT_DIR=./Layout
# REAPPROVAL_CURRENT_YEAR=2025

# OCR для legacy PDF (если установлен Tesseract)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANG=rus+eng

# Папка со структурой учебных планов (дерево на /validation)
# PLANS_FOLDER=./УЧЕБНЫЕ ПЛАНЫ
# Автоимпорт .plx/.xlsx из папки (фоном при старте сервера + по кнопке ↻)
# PLANS_AUTO_IMPORT=true
# PLANS_DELETE_AFTER_IMPORT=true
# Импорт при каждом открытии дерева (медленно — лучше false)
# PLANS_SYNC_ON_NAV=false
# Кэш сканирования папки УП, секунд (0 = без кэша)
# PLANS_FOLDER_SCAN_CACHE_SECONDS=60
# Сколько новых файлов импортировать за один sync (сначала самые свежие)
# PLANS_SYNC_BATCH_SIZE=15

# Конвертация старых .doc при загрузке РПД/ФОС (нужен Microsoft Word на Windows или LibreOffice)
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# --- Безопасность и вход (рекомендуется для продакшена) ---
# AUTH_ENABLED=true
# SIGNATURES_DIR=./data/private/signatures
# EDIT_LOCKS_ENABLED=true
# STRUCTURED_RPD_ENABLED=true
# ADMIN1_USERNAME=methodist1
# ADMIN1_NAME=Иванова
# ADMIN1_PASSWORD=changeme
# ADMIN2_USERNAME=methodist2
# ADMIN2_NAME=Петрова
# ADMIN2_PASSWORD=changeme
# MAX_ADMIN_USERS=2
# ALLOW_SELF_REGISTRATION=false
# LOCK_TTL_SECONDS=900
# SESSION_TTL_SECONDS=86400
# MAX_UPLOAD_MB=100
# EXPORT_RETENTION_HOURS=48
# BLOCKING_IO_MAX_PARALLEL=2
# EXPORT_BATCH_MAX_PARALLEL=3

# --- ИИ-помощник на странице сверки (/validation → редактор документа) ---
# AI_ASSISTANT_ENABLED=true
# AI_API_KEY=sk-...
# AI_API_BASE=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_SECONDS=45
